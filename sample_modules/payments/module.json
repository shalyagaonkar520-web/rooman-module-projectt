{
  "name": "Payments",
  "slug": "payments",
  "version": "2.1.0",
  "description": "Unified payments gateway module supporting Stripe, PayPal, webhooks, and subscription billing.",
  "author": "PayStack Labs",
  "category": "Payments",
  "technologies": [
    "TypeScript",
    "Stripe SDK",
    "Node.js"
  ],
  "entryPoints": {
    "frontend": "frontend/PaymentCheckout.tsx",
    "backend": "backend/stripeWebhook.ts"
  },
  "routes": [
    "/checkout",
    "/api/webhooks/stripe"
  ],
  "inputs": [
    {
      "name": "amount_cents",
      "type": "number"
    },
    {
      "name": "currency",
      "type": "string"
    }
  ],
  "outputs": [
    {
      "name": "payment_intent",
      "type": "StripeIntent"
    }
  ],
  "dependencies": [],
  "description_for_ai": "Payments provides secure card checkout, webhook verification, and subscription invoice handling."
}
