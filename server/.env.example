# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev: SQLite file (relative to server/)
DATABASE_URL="file:./dev.db"
#
# Production (Vercel): use a cloud database. Examples:
#   PlanetScale (MySQL):  DATABASE_URL="mysql://user:pass@host/db?sslaccept=strict"
#   Neon (Postgres):      DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
#   Supabase (Postgres):  DATABASE_URL="postgresql://postgres:pass@db.xxxx.supabase.co:5432/postgres"
#
# After changing the provider, update prisma/schema.prisma datasource block:
#   provider = "postgresql"   (or "mysql")
# Then run:  npm run db:push

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins in production.
# Example: https://moduleforge.vercel.app,https://www.moduleforge.io
ALLOWED_ORIGINS=https://your-app.vercel.app

# ── GitHub Webhook Integration ─────────────────────────────────────────────────
# Personal access token — needs `repo` or `admin:repo_hook` scope.
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public HTTPS URL of this server that GitHub will POST push events to.
# Vercel production:  https://your-app.vercel.app
# Local dev (ngrok):  https://xxxx.ngrok-free.app
WEBHOOK_PUBLIC_URL=https://your-app.vercel.app

# HMAC secret — must match the "Secret" field in the GitHub webhook settings.
# Use a long random string in production.
GITHUB_WEBHOOK_SECRET=change_me_to_a_long_random_secret

# ── Supabase (optional — enables real authentication) ─────────────────────────
# Leave blank to run in local dev mode (localStorage auth only).
# Get these from: https://app.supabase.com → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Client env vars (set these in Vercel Dashboard → Settings → Env Vars) ─────
# These are injected into the Vite build at build time — prefix with VITE_
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Optional: set only if API is hosted on a different domain than the frontend
# VITE_API_URL=https://api.yourserver.com

# ── Deploy to Vercel ───────────────────────────────────────────────────────────
# 1. Push this repo to GitHub
# 2. Go to https://vercel.com/new → Import your GitHub repo
# 3. Framework: Other (vercel.json handles everything)
# 4. Add ALL the production env vars above in Vercel Dashboard
# 5. For the database, provision a Neon or PlanetScale DB, update DATABASE_URL
#    and change prisma/schema.prisma provider, then redeploy
# 6. After first deploy, open any GitHub module → Register Webhook
#    (WEBHOOK_PUBLIC_URL will be your Vercel deployment URL)
