# ── Supabase (required for production auth) ───────────────────────────────────
# Get these from: https://app.supabase.com → Project Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── API base URL (optional) ───────────────────────────────────────────────────
# Leave blank when frontend and API are on the same Vercel deployment.
# Set this only if you host the API separately (e.g. Railway, Render, Fly.io).
# VITE_API_URL=https://api.yourserver.com
