{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["client/src/*"],
      "react": ["client/node_modules/@types/react", "client/node_modules/react"],
      "react/*": ["client/node_modules/@types/react/*", "client/node_modules/react/*"],
      "react-dom": ["client/node_modules/@types/react-dom", "client/node_modules/react-dom"],
      "react-dom/*": ["client/node_modules/@types/react-dom/*", "client/node_modules/react-dom/*"]
    },
    "typeRoots": [
      "./client/node_modules/@types",
      "./server/node_modules/@types"
    ]
  },
  "include": [
    "client/src/**/*",
    "sample_modules/**/*"
  ]
}
